cabal-version:   3.0
name:            intercalate
version:         0.1.0.0
synopsis:        Join monoidal values together with a separator
license:         MIT
license-file:    LICENSE
author:          Giorgio Marinelli
maintainer:      giorgio@marinel.li
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Data.Monoid.Intercalate
    Data.String.Intercalate

  build-depends:    base >=4.11 && <5
  hs-source-dirs:   src
  default-language: Haskell2010

test-suite intercalate-test
  import:           warnings
  default-language: Haskell2010
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base         >=4.11 && <5
    , intercalate
