cabal-version:   3.0
name:            intercalate
version:         1.0.0.0
synopsis:        Join monoidal values together with a separator
description:
  Combinators that join 'Semigroup' and 'Monoid' values with a separator.
  "Data.Monoid.Intercalate" has 'Data.List.intercalate' for any 'Foldable'
  of 'Monoid' values. "Data.String.Intercalate" adds variants that separate
  string-like values with spaces.

category:        Data, Text
homepage:        https://github.com/marinelli/intercalate
bug-reports:     https://github.com/marinelli/intercalate/issues
license:         BSD-3-Clause
license-file:    LICENSE
author:          Giorgio Marinelli
maintainer:      giorgio@marinel.li
build-type:      Simple
extra-doc-files: CHANGELOG.md
tested-with:     GHC ==9.10.3 || ==9.12.4 || ==9.14.1

source-repository head
  type:     git
  location: https://github.com/marinelli/intercalate.git

common common-stanza
  default-language:   Haskell2010
  default-extensions:
    ImportQualifiedPost
    OverloadedStrings

  ghc-options:        -Wall -Werror=prepositive-qualified-module
  build-depends:      base >=4.14 && <5

library
  import:          common-stanza
  hs-source-dirs:  src
  exposed-modules:
    Data.Monoid.Intercalate
    Data.String.Intercalate

test-suite intercalate-test
  import:         common-stanza
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , intercalate
    , text
