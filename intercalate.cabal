cabal-version:   3.0
name:            intercalate
version:         1.0.0.0
synopsis:        Join monoidal values together with a separator
description:
  Combinators that join 'Semigroup' and 'Monoid' values with a separator.
  "Data.Monoid.Intercalate" has 'Data.List.intercalate' and
  'Data.List.unwords' for any 'Foldable' of 'Monoid' values.
  "Data.Monoid.Intercalate.SkipEmpty" has variants that leave out empty
  values.

category:        Data, Text
homepage:        https://github.com/marinelli/intercalate
bug-reports:     https://github.com/marinelli/intercalate/issues
license:         BSD-3-Clause
license-file:    LICENSE
author:          Giorgio Marinelli
maintainer:      giorgio@marinel.li
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

tested-with:
  GHC ^>=9.2 || ^>=9.4 || ^>=9.6 || ^>=9.8 || ^>=9.10 || ^>=9.12 || ^>=9.14

source-repository head
  type:     git
  location: https://github.com/marinelli/intercalate.git

common common-stanza
  default-language:   Haskell2010
  default-extensions: ImportQualifiedPost
  ghc-options:        -Wall -Werror=prepositive-qualified-module
  build-depends:      base >=4.16 && <5

library
  import:          common-stanza
  hs-source-dirs:  src
  exposed-modules:
    Data.Monoid.Intercalate
    Data.Monoid.Intercalate.SkipEmpty

test-suite intercalate-test
  import:         common-stanza
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , bytestring
    , intercalate
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , template-haskell
    , text

benchmark intercalate-bench
  import:         common-stanza
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  ghc-options:    -with-rtsopts=-T
  build-depends:
    , bytestring
    , deepseq
    , intercalate
    , tasty-bench
    , text
